[Unit]
Description=Silentary personal AI secretary platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# !!! Adjust User, WorkingDirectory and EnvironmentFile to your deployment !!!
User=silentary
Group=silentary
WorkingDirectory=/opt/silentary
EnvironmentFile=/opt/silentary/.env

# venv python runs uvicorn programmatically to reuse app settings
ExecStart=/opt/silentary/.venv/bin/python run.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# nanobot probes legacy fallback dirs under $HOME (~/.nanobot/sessions) on
# EVERY session operation; under ProtectHome=true those stat() calls throw
# EACCES (PermissionError, not ENOENT) and kill chat/history/delete. Point
# HOME into the writable data tree so the legacy path resolves inside it and
# misses cleanly. Environment= overrides anything in EnvironmentFile.
Environment=HOME=/opt/silentary/data/nanobot/home

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/silentary/data /opt/silentary/workspaces
ProtectHome=true

[Install]
WantedBy=multi-user.target
