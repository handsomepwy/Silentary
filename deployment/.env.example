# Silentary environment file — copy to .env and fill in.
# Used by systemd (EnvironmentFile) and docker-free local runs.
# Keep this file OUT of version control.

# Owner dashboard token (required in production; if unset, one is generated
# and written to data/owner_token.txt at first boot).
SILENTARY_OWNER_TOKEN=change-me-to-a-long-random-token

# LLM provider API key (required for the agent).
# `provider` is derived from the model prefix, e.g. anthropic, openai, openrouter.
SILENTARY_PROVIDER_API_KEY=sk-...

# Model in provider/model format (default: anthropic/claude-opus-4-5)
SILENTARY_MODEL=anthropic/claude-opus-4-5

# Optional overrides
# SILENTARY_HOST=127.0.0.1
# SILENTARY_PORT=8000
# SILENTARY_DATA_DIR=/opt/silentary/data
# SILENTARY_WORKSPACES_DIR=/opt/silentary/workspaces
