# Silentary local configuration — copy to .env and fill in.
# .env is gitignored; real environment variables still take precedence.
# Precedence: process env > .env > data/config.json > defaults.

# Owner dashboard token (required; used to sign in at /admin)
SILENTARY_OWNER_TOKEN=

# LLM provider API key (required for the agent; leave blank to run dashboard-only)
SILENTARY_PROVIDER_API_KEY=

# Model in provider/model format (default: anthropic/claude-opus-4-5)
# SILENTARY_MODEL=anthropic/claude-opus-4-5

# Optional overrides
# SILENTARY_HOST=127.0.0.1
# SILENTARY_PORT=8000
# Hard daily agent-turn quota per visitor (default 200)
# SILENTARY_CHAT_DAILY_QUOTA=200
# Set true ONLY behind the bundled nginx config; leave false otherwise
# SILENTARY_TRUST_PROXY_HEADERS=false
